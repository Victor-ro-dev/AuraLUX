# ─────────────────────────────────────────────
#  AuraLUX Backend - Environment Variables
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA commite o .env com valores reais!
# ─────────────────────────────────────────────

# ── Banco de dados ─────────────────────────────
# SQLite (local/dev):
DATABASE_URL=sqlite:///./auralux.db
# PostgreSQL (produção):
# DATABASE_URL=postgresql://user:password@host:5432/auralux

# ── Segurança JWT ──────────────────────────────
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-forte
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Broker MQTT (Mosquitto) ────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── CORS ──────────────────────────────────────
# Em produção, substitua pelo domínio real do frontend
CORS_ORIGINS=http://localhost:5173

# ── Microsoft Graph API (Outlook) ─────────────
# Registre um app no Azure: https://portal.azure.com → App registrations
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_TENANT_ID=common
