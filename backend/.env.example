# ─────────────────────────────────────────────
#  AuraLUX Backend - Environment Variables
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA commite o .env com valores reais!
#
#  Todas as variáveis são centralizadas em: src/core/config.py
#  Importe sempre de lá: from src.core.config import settings
# ─────────────────────────────────────────────

# ── Banco de dados ─────────────────────────────
# SQLite (local/dev):
DATABASE_URL=sqlite:///./auralux.db
# PostgreSQL via Supabase (produção):
# Obtenha em: supabase.com → seu projeto → Settings → Database → Connection string → URI
# DATABASE_URL=postgresql://postgres:[SUA-SENHA]@db.[REF].supabase.co:5432/postgres

# ── Segurança JWT ──────────────────────────────
# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-secreta-forte
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Redis Broker ────────────────────────────────
# URL do servidor Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS ──────────────────────────────────────
# Em produção, substitua pelo domínio real do frontend (vírgula para múltiplos)
# Ex: CORS_ORIGINS=https://auralux.vercel.app,https://meudominio.com
CORS_ORIGINS=http://localhost:5173

# ── Microsoft Graph API (Outlook) ─────────────
# Registre um app no Azure: https://portal.azure.com → App registrations
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_TENANT_ID=common
# URL de redirecionamento que a Microsoft deve usar (deve corresponder ao registrado no Azure)
# Em dev: http://localhost:5173/auth/outlook/callback
OUTLOOK_REDIRECT_URI=http://localhost:5173/auth/outlook/callback

# ── Google Gemini AI (Event Classification) ───
# Gere uma chave em: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your-gemini-api-key
