# ─────────────────────────────────────────────
#  AuraLUX Frontend - Environment Variables
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA commite o .env com valores reais!
# ─────────────────────────────────────────────

# ── URL da API (backend) ───────────────────────
# Em dev: deixe vazio (o proxy do Vite resolve automaticamente)
# Em produção: coloque a URL do Railway
# VITE_API_URL=https://auralux-backend.up.railway.app
VITE_API_URLVITE_API_URL=

# ── Microsoft Azure - Integração Outlook ──────
# Registre um app em: https://portal.azure.com → App registrations
VITE_OUTLOOK_CLIENT_ID=your-azure-app-client-id
VITE_OUTLOOK_REDIRECT_URI=http://localhost:5173/auth/outlook/callback

# Em produção: https://seu-dominio.com/auth/outlook/callback (use o mesmo caminho registrado no Azure)
