# ─────────────────────────────────────────────
#  AuraLUX Frontend - Environment Variables
#  Copie este arquivo para .env e preencha os valores reais.
#  NUNCA commite o .env com valores reais!
# ─────────────────────────────────────────────

# ── Microsoft Azure - Integração Outlook ──────
# Registre um app em: https://portal.azure.com → App registrations
VITE_OUTLOOK_CLIENT_ID=your-azure-app-client-id

# URI de redirecionamento cadastrada no Azure (deve bater exatamente)
# Em produção: https://seu-dominio.com/auth/outlook/callback
VITE_OUTLOOK_REDIRECT_URI=http://localhost:5173/auth/outlook/callback
